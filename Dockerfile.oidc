# syntax=docker/dockerfile:1
FROM rust:1.98-alpine AS build
RUN apk add --no-cache build-base perl openssl-dev pkgconf ca-certificates
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --locked --release -p atuin-server --features vendored-tls \
    && cp target/release/atuin-server /atuin-server
RUN mkdir /config /runtime-tmp && chmod 1777 /runtime-tmp

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/GameTec-live/atuin-oidc"
COPY --from=build /atuin-server /atuin-server
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chown=65532:65532 /config /config
COPY --from=build /runtime-tmp /tmp
USER 65532:65532
WORKDIR /config
ENV ATUIN_CONFIG_DIR=/config ATUIN_HOST=0.0.0.0 RUST_LOG=atuin_server=info \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
EXPOSE 8888
ENTRYPOINT ["/atuin-server"]
CMD ["start"]
